# Copy to .env (never committed). Everything here is optional.

# Where the apps run, when not on the default local ports.
# SUPERSHIP_URL=http://localhost:3001
# SUPERPLATFORM_URL=http://localhost:3000

# Where the apps' and the backend's source code is, read when writing a new flow (never changed).
# The defaults are the folders next to this one.
# SUPERSHIP_SRC=../SuperShip UI
# SUPERPLATFORM_SRC=../SuperPlatform UI
# BACKEND_SRC=../Server
